.DEFAULT_GOAL := help
IMAGE ?= {{ service_name }}:dev

.PHONY: help install lint fmt typecheck imports test test-unit check run{% if with_database %} migrate migration{% endif %} docker-build docker-run update-template

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-16s %s\n", $$1, $$2}'

install: ## Install dependencies and pre-commit hooks
	uv sync
	uv run pre-commit install

lint: ## Ruff lint and format check
	uv run ruff check .
	uv run ruff format --check .

fmt: ## Auto-fix lint and format
	uv run ruff check --fix .
	uv run ruff format .

typecheck: ## Pyright (strict)
	uv run pyright

imports: ## Import-linter layer contracts
	uv run lint-imports

test: ## Pytest with coverage, `integration` tests included{% if with_database %} (need Docker){% endif %}
	uv run pytest --cov --cov-report=term

test-unit: ## Pytest without tests marked `integration`
	uv run pytest -m "not integration"

check: lint typecheck imports test ## Everything CI runs

run: ## Run locally with reload (needs .env, see .env.example)
	uv run --env-file .env uvicorn {{ package_name }}.main:create_app --factory --reload --port {{ http_port }} --no-access-log
{%- if with_database %}

migrate: ## Apply database migrations (DB__URL from .env or the environment)
	uv run alembic upgrade head

migration: ## New migration from model changes: make migration name=add_recipes
	@test -n "$(name)" || { echo "usage: make migration name=add_recipes"; exit 1; }
	uv run alembic revision --autogenerate -m "$(name)"
{%- endif %}

docker-build: ## Build the image
	docker build -t $(IMAGE) .

docker-run: docker-build ## Run the image against meal-platform on localhost
	docker run --rm -p {{ http_port }}:{{ http_port }} --network meal-platform \
		-e OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318 $(IMAGE)

update-template: ## Pull changes from meal-service-template
	uvx copier update --trust --skip-answered
