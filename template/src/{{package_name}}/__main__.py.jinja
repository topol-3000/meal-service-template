import uvicorn

from {{ package_name }}.settings import get_settings


def main() -> None:
    settings = get_settings()
    uvicorn.run(
        "{{ package_name }}.main:create_app",
        factory=True,
        host=settings.http_host,
        port=settings.http_port,
        # Logging is configured by the app itself (structlog + OTel).
        log_config=None,
        access_log=False,
    )


if __name__ == "__main__":
    main()
