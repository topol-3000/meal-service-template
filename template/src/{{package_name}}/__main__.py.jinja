{% if with_database -%}
import argparse
from collections.abc import Sequence

import uvicorn

from {{ package_name }}.infrastructure.db.migrate import upgrade_to_head
from {{ package_name }}.observability import configure_logging
from {{ package_name }}.settings import get_settings


def main(argv: Sequence[str] | None = None) -> None:
    """`serve` (default) runs the HTTP server; `migrate` applies migrations and exits."""
    parser = argparse.ArgumentParser(prog="{{ service_name }}")
    parser.add_argument("command", nargs="?", choices=["serve", "migrate"], default="serve")
    args = parser.parse_args(argv)
    if args.command == "migrate":
        migrate()
    else:
        serve()


def serve() -> None:
{%- else -%}
import uvicorn

from {{ package_name }}.settings import get_settings


def main() -> None:
{%- endif %}
    settings = get_settings()
    uvicorn.run(
        "{{ package_name }}.main:create_app",
        factory=True,
        host=settings.http_host,
        port=settings.http_port,
        # Logging is configured by the app itself (structlog + OTel).
        log_config=None,
        access_log=False,
    )
{%- if with_database %}


def migrate() -> None:
    """Run as a one-off job from the service image, before the new version starts.

    Migrations must keep working with the version still running: add first, remove in a
    later release (expand, then contract).
    """
    settings = get_settings()
    configure_logging(settings)
    upgrade_to_head(settings.db.url.get_secret_value())
{%- endif %}


if __name__ == "__main__":
    main()
