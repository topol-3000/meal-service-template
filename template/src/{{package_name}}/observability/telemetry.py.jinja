from {{ package_name }}.settings import Settings

# Probes are polled every few seconds and only add noise to Tempo.
_EXCLUDED_URLS = "health/live,health/ready"


@dataclass(frozen=True)
class Telemetry:
    """Providers created by `setup_telemetry`; `None` when telemetry is disabled."""

    tracer_provider: TracerProvider | None = None
    meter_provider: MeterProvider | None = None
    logger_provider: LoggerProvider | None = None

    def shutdown(self) -> None:
        """Flush and stop exporters. Call once on application shutdown."""
        for provider in (self.tracer_provider, self.meter_provider, self.logger_provider):
            if provider is not None:
                provider.shutdown()


def setup_telemetry(settings: Settings) -> Telemetry:
    """Register global trace, metric and log providers exporting over OTLP/HTTP.

    The endpoint comes from `OTEL_EXPORTER_OTLP_ENDPOINT` (default http://localhost:4318).
    Global providers can be set only once per process, so tests disable this and
    install their own in-memory providers instead.
    """
    if not settings.otel_enabled:
        return Telemetry()

    resource = Resource.create(
        {
            "service.name": settings.service_name,
            "service.version": settings.service_version,
            "deployment.environment.name": settings.environment,
        }
    )

    tracer_provider = TracerProvider(resource=resource)
    tracer_provider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter()))
    trace.set_tracer_provider(tracer_provider)

    meter_provider = MeterProvider(
        resource=resource,
        metric_readers=[PeriodicExportingMetricReader(OTLPMetricExporter())],
    )
    metrics.set_meter_provider(meter_provider)

    logger_provider = LoggerProvider(resource=resource)
    logger_provider.add_log_record_processor(BatchLogRecordProcessor(OTLPLogExporter()))
    set_logger_provider(logger_provider)

    return Telemetry(tracer_provider, meter_provider, logger_provider)


{% if with_database or with_cache -%}
def instrument_app(app: FastAPI) -> None:
{%- if with_database and with_cache %}
    """Auto-instrument incoming FastAPI requests, httpx2 calls, SQLAlchemy and Valkey commands."""
{%- elif with_database %}
    """Auto-instrument incoming FastAPI requests, outgoing httpx2 calls and SQLAlchemy queries."""
{%- else %}
    """Auto-instrument incoming FastAPI requests, outgoing httpx2 calls and Valkey commands."""
{%- endif %}
    # Stable HTTP and database semantic conventions: `http.server.request.duration` in seconds,
    # `http.request.method`, `db.system.name`, `db.query.text`, ... instead of the legacy names.
    # Read on first instrumentation.
    os.environ.setdefault("OTEL_SEMCONV_STABILITY_OPT_IN", "http,database")
{%- else -%}
def instrument_app(app: FastAPI) -> None:
    """Auto-instrument incoming FastAPI requests and outgoing httpx2 calls."""
    # Stable HTTP semantic conventions: `http.server.request.duration` in seconds,
    # `http.request.method`, ... instead of the legacy names. Read on first instrumentation.
    os.environ.setdefault("OTEL_SEMCONV_STABILITY_OPT_IN", "http")
{%- endif %}
    FastAPIInstrumentor.instrument_app(app, excluded_urls=_EXCLUDED_URLS)
    httpx_instrumentor = HTTPX2ClientInstrumentor()
    if not httpx_instrumentor.is_instrumented_by_opentelemetry:
        httpx_instrumentor.instrument()
{%- if with_database %}
    # Patches engine creation, so the engine created later in the lifespan is traced.
    sqlalchemy_instrumentor = SQLAlchemyInstrumentor()
    if not sqlalchemy_instrumentor.is_instrumented_by_opentelemetry:
        sqlalchemy_instrumentor.instrument()
{%- endif %}
{%- if with_cache %}
    # Patches redis-py's client classes, so the client created later in the lifespan is traced.
    # Commands are recorded without their arguments (`GET ?`): keys and values stay out of spans.
    redis_instrumentor = RedisInstrumentor()
    if not redis_instrumentor.is_instrumented_by_opentelemetry:
        # Its override of `instrument` leaves `**kwargs` untyped; none are passed.
        redis_instrumentor.instrument()  # pyright: ignore[reportUnknownMemberType]
{%- endif %}


def get_tracer(name: str) -> trace.Tracer:
    return trace.get_tracer(name)


def get_meter(name: str) -> metrics.Meter:
    return metrics.get_meter(name)
