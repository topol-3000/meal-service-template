from sqlalchemy import text
from sqlalchemy.ext import asyncio as sqlalchemy_asyncio
from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession, async_sessionmaker

from {{ package_name }}.settings import DatabaseSettings


def create_db_engine(settings: DatabaseSettings) -> AsyncEngine:
    """Build the service's one connection pool.

    It is created in the lifespan (`main.py`) and disposed on shutdown. Queries are traced by
    the SQLAlchemy instrumentation in `observability.instrument_app`, which patches
    `create_async_engine` on its module: call it through the module, not a direct import,
    so the patched function is the one used.
    """
    return sqlalchemy_asyncio.create_async_engine(
        settings.url.get_secret_value(),
        pool_size=settings.pool_size,
        max_overflow=settings.max_overflow,
        # A connection the database closed (restart, idle timeout) is replaced, not handed out.
        pool_pre_ping=True,
    )


def create_session_factory(engine: AsyncEngine) -> async_sessionmaker[AsyncSession]:
    # Objects stay readable after commit; in async code an expired attribute can't lazy-load.
    return async_sessionmaker(engine, expire_on_commit=False)


async def ping(engine: AsyncEngine) -> None:
    """Readiness check: raises when the database does not answer."""
    async with engine.connect() as connection:
        await connection.execute(text("SELECT 1"))
