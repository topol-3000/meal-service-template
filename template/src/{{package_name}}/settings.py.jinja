from functools import lru_cache
from typing import Literal

{% if with_database or with_cache -%}
from pydantic import (
    BaseModel,
    ConfigDict,
    Field,
{%- if with_database %}
    NonNegativeInt,
{%- endif %}
    PositiveFloat,
    PositiveInt,
    SecretStr,
    field_validator,
)
{% else -%}
from pydantic import BaseModel, ConfigDict, Field, PositiveFloat, PositiveInt
{% endif -%}
from pydantic_settings import BaseSettings, SettingsConfigDict


class HttpClientSettings(BaseModel):
    """Shared outgoing HTTP client (`infrastructure/http.py`). Env: `HTTP_CLIENT__<FIELD>`."""

    model_config = ConfigDict(frozen=True)

    timeout_seconds: PositiveFloat = 10.0
    connect_timeout_seconds: PositiveFloat = 5.0
    max_connections: PositiveInt = 100


{% if with_database -%}
class DatabaseSettings(BaseModel):
    """PostgreSQL (`infrastructure/db/`). Env: `DB__<FIELD>`."""

    model_config = ConfigDict(frozen=True)

    # postgresql+asyncpg://user:password@host:5432/dbname
    url: SecretStr
    pool_size: PositiveInt = 5
    max_overflow: NonNegativeInt = 10

    @field_validator("url")
    @classmethod
    def _uses_asyncpg(cls, url: SecretStr) -> SecretStr:
        if not url.get_secret_value().startswith("postgresql+asyncpg://"):
            raise ValueError("must start with postgresql+asyncpg:// (the async driver)")
        return url


{% endif -%}
{% if with_cache -%}
class CacheSettings(BaseModel):
    """Valkey cache (`infrastructure/cache/`). Env: `CACHE__<FIELD>`."""

    model_config = ConfigDict(frozen=True)

    # redis://[:password@]host:6379/0, or rediss://... for TLS
    url: SecretStr
    default_ttl_seconds: PositiveInt = 300
    # Short: a cache slower than this saves nothing, and a timeout only costs a miss.
    connect_timeout_seconds: PositiveFloat = 0.5
    timeout_seconds: PositiveFloat = 0.5

    @field_validator("url")
    @classmethod
    def _uses_redis_scheme(cls, url: SecretStr) -> SecretStr:
        if not url.get_secret_value().startswith(("redis://", "rediss://")):
            raise ValueError("must start with redis:// or rediss://")
        return url


{% endif -%}
class Settings(BaseSettings):
    """Service configuration, read from environment variables and `.env`.

    Each adapter gets its own sub-model, filled from `<FIELD>__<SUBFIELD>` variables
    (`HTTP_CLIENT__TIMEOUT_SECONDS=5`), and receives only that slice in `__init__`.
{%- if with_database %}
    Secrets are `SecretStr` fields in a sub-model, like `DatabaseSettings.url` (`DB__URL`).
{%- elif with_cache %}
    Secrets are `SecretStr` fields in a sub-model, like `CacheSettings.url` (`CACHE__URL`).
{%- else %}
    Secrets are `SecretStr` fields in a sub-model, for example `api_key: SecretStr` in an
    `LlmSettings` read from `LLM__API_KEY`.
{%- endif %}
    Call `.get_secret_value()` only where the value is used; never log it or put it on a span.

    OpenTelemetry exporters read the standard `OTEL_*` variables themselves
    (`OTEL_EXPORTER_OTLP_ENDPOINT`, `OTEL_RESOURCE_ATTRIBUTES`, ...).
    """

    model_config = SettingsConfigDict(
        env_file=".env",
        extra="ignore",
        env_nested_delimiter="__",
        # Startup errors name the field and the rule but not the value: it may be a secret.
        hide_input_in_errors=True,
    )

    service_name: str = "{{ service_name }}"
    service_version: str = "0.1.0"
    environment: Literal["local", "test", "dev", "prod"] = "local"

    http_host: str = "0.0.0.0"  # noqa: S104 - runs in a container
    http_port: int = {{ http_port }}

    log_level: Literal["DEBUG", "INFO", "WARNING", "ERROR"] = "INFO"
    log_format: Literal["json", "console"] = "json"

    otel_enabled: bool = True

    # Per check of `/health/ready`; keep it below the probe's own timeout.
    readiness_check_timeout_seconds: PositiveFloat = 2.0

    http_client: HttpClientSettings = Field(default_factory=HttpClientSettings)
{%- if with_database %}
    # Required: the service does not start without DB__URL.
    db: DatabaseSettings
{%- endif %}
{%- if with_cache %}
    # Required too, but the service starts and serves requests while Valkey is down.
    cache: CacheSettings
{%- endif %}


@lru_cache
def get_settings() -> Settings:
{%- if with_database or with_cache %}
    # Required fields ({{ ((["`db`"] if with_database else []) + (["`cache`"] if with_cache else [])) | join(", ") }}) come from the environment, which pyright can't see.
    return Settings()  # pyright: ignore[reportCallIssue]
{%- else %}
    return Settings()
{%- endif %}
