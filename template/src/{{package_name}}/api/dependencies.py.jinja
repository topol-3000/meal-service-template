"""How routes get what they need: typed providers over the state opened in the lifespan.

Routes declare dependencies with the aliases below (`settings: SettingsDep`), never by
reading `request.app.state` themselves. Tests replace a provider through
`app.dependency_overrides[get_app_state]`.
"""

{% if with_database -%}
from collections.abc import AsyncIterator, Awaitable, Callable, Mapping
{% else -%}
from collections.abc import Awaitable, Callable, Mapping
{% endif -%}
from dataclasses import dataclass, field
from typing import Annotated

import httpx2
from fastapi import Depends, Request
{%- if with_database %}
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
{%- endif %}

{% if with_cache -%}
from {{ package_name }}.infrastructure.cache.valkey import ValkeyCache
{% endif -%}
from {{ package_name }}.settings import Settings

# Raises when the resource is unavailable (e.g. a database ping).
type ReadinessCheck = Callable[[], Awaitable[None]]


@dataclass(frozen=True, slots=True)
class AppState:
    """Resources opened in the lifespan (`main.py`), stored on `app.state.app_state`."""

    settings: Settings
    http_client: httpx2.AsyncClient
{%- if with_database %}
    db_session_factory: async_sessionmaker[AsyncSession]
{%- endif %}
{%- if with_cache %}
    cache: ValkeyCache
{%- endif %}
    # Checked by `/health/ready`, keyed by resource name.
    readiness_checks: Mapping[str, ReadinessCheck] = field(
        default_factory=dict[str, ReadinessCheck]
    )


def get_app_state(request: Request) -> AppState:
    return request.app.state.app_state


type AppStateDep = Annotated[AppState, Depends(get_app_state)]


def get_app_settings(state: AppStateDep) -> Settings:
    return state.settings


def get_http_client(state: AppStateDep) -> httpx2.AsyncClient:
    return state.http_client


type SettingsDep = Annotated[Settings, Depends(get_app_settings)]
type HttpClientDep = Annotated[httpx2.AsyncClient, Depends(get_http_client)]
{%- if with_cache %}


def get_cache(state: AppStateDep) -> ValkeyCache:
    return state.cache


# For the adapters behind feature ports (`infrastructure/cache/`), not for use cases directly.
type CacheDep = Annotated[ValkeyCache, Depends(get_cache)]
{%- endif %}
{%- if with_database %}


async def get_db_session(state: AppStateDep) -> AsyncIterator[AsyncSession]:
    """One session and one transaction per request.

    Committed when the route returns, rolled back when it raises (the error then reaches the
    handlers in `api/errors.py` as usual). Repositories receive this session; they never
    commit themselves.
    """
    async with state.db_session_factory() as session, session.begin():
        yield session


# scope="function": the commit happens before the response is sent, so a failed commit
# becomes an error response instead of a 200 for data that was never stored.
type DbSessionDep = Annotated[AsyncSession, Depends(get_db_session, scope="function")]
{%- endif %}
