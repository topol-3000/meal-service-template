[project]
name = "{{ service_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [{ name = "{{ author_name }}" }]
requires-python = ">={{ python_version }}"
dependencies = [
    "fastapi>=0.162",
    "uvicorn[standard]>=0.54",
    "pydantic>=2.14",
    "pydantic-settings>=2.16",
    "structlog>=26.1",
    "httpx2>=2.16",
    "opentelemetry-api>=1.45",
    "opentelemetry-sdk>=1.45",
    "opentelemetry-exporter-otlp-proto-http>=1.45",
    "opentelemetry-instrumentation-fastapi>=0.66b1",
    "opentelemetry-instrumentation-httpx>=0.66b1",
{%- if with_database %}
    # <2.1 until opentelemetry-instrumentation-sqlalchemy > 0.66b1 (no 2.1 support before).
    "sqlalchemy[asyncio]>=2.0.55,<2.1",
    "asyncpg>=0.32",
    "alembic>=1.20.1",
    "opentelemetry-instrumentation-sqlalchemy>=0.66b1",
{%- endif %}
]

[project.scripts]
{{ service_name }} = "{{ package_name }}.__main__:main"

[dependency-groups]
dev = [
    "pytest>=9.1",
    "pytest-asyncio>=1.4",
    "pytest-cov>=7.0",
    "ruff>=0.17",
    "pyright>=1.1.414",
    "import-linter>=2.15",
    "pre-commit>=4.7",
{%- if with_database %}
    "testcontainers[postgres]>=4.15",
{%- endif %}
]

[build-system]
requires = ["uv_build>=0.11,<0.12"]
build-backend = "uv_build"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E", "W", "F", "I", "N", "UP", "B", "A", "C4", "SIM", "RET", "PTH",
    "ASYNC", "S", "T20", "PT", "RUF", "TRY", "FBT", "PL", "LOG", "G", "TID",
]
ignore = [
    "PLR2004", # magic values are fine in tests and status codes
    "TRY003",  # long messages in exceptions are fine
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "PLR2004", "FBT"]

[tool.ruff.lint.flake8-tidy-imports.banned-api]
"logging.getLogger".msg = "Use structlog.get_logger() from {{ package_name }}.observability"
"requests".msg = "Use httpx2 (async) through the shared client in infrastructure/http.py"
"aiohttp".msg = "Use httpx2 through the shared client in infrastructure/http.py"
"httpx".msg = "Use httpx2, the maintained successor of httpx"
"typing.Optional".msg = "Use `X | None`"
"typing.Union".msg = "Use `X | Y`"
"typing.List".msg = "Use the built-in `list`"
"typing.Dict".msg = "Use the built-in `dict`"

[tool.pyright]
include = ["src", "tests"]
pythonVersion = "{{ python_version }}"
typeCheckingMode = "strict"
venvPath = "."
venv = ".venv"
reportMissingTypeStubs = false

# Layering (see AGENTS.md). Run with `make imports`; part of `make check`.
[tool.importlinter]
root_package = "{{ package_name }}"
include_external_packages = true

[[tool.importlinter.contracts]]
name = "Layers: api -> application | infrastructure -> domain"
type = "layers"
containers = ["{{ package_name }}"]
# `|`: application and infrastructure must not import each other.
layers = ["api", "application | infrastructure", "domain"]

[[tool.importlinter.contracts]]
name = "Domain and application stay framework-free"
type = "forbidden"
source_modules = ["{{ package_name }}.domain", "{{ package_name }}.application"]
forbidden_modules = ["fastapi", "starlette", "sqlalchemy", "httpx2", "redis", "pydantic_settings"]
# Direct imports only: use cases may import observability and settings, which use these.
allow_indirect_imports = true

[[tool.importlinter.contracts]]
name = "Domain does not depend on observability or settings"
type = "forbidden"
source_modules = ["{{ package_name }}.domain"]
forbidden_modules = ["{{ package_name }}.observability", "{{ package_name }}.settings"]

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
addopts = "-ra --strict-markers --strict-config"
filterwarnings = ["error"]
markers = ["integration: needs Docker (testcontainers); `make test-unit` skips these"]

{% if with_database -%}
[tool.alembic]
# For the `alembic` CLI (`make migration name=...`); `python -m {{ package_name }} migrate`
# builds the same config in infrastructure/db/migrate.py.
script_location = "{{ package_name }}.infrastructure.db:migrations"
file_template = "%%(year)d_%%(month).2d_%%(day).2d_%%(hour).2d%%(minute).2d_%%(rev)s_%%(slug)s"

[[tool.alembic.post_write_hooks]]
name = "ruff_fix"
type = "module"
module = "ruff"
options = "check --fix REVISION_SCRIPT_FILENAME"

[[tool.alembic.post_write_hooks]]
name = "ruff_format"
type = "module"
module = "ruff"
options = "format REVISION_SCRIPT_FILENAME"

{% endif -%}
[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true
