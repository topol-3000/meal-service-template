[project]
name = "{{ service_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [{ name = "{{ author_name }}" }]
requires-python = ">={{ python_version }}"
dependencies = [
    "fastapi>=0.162",
    "uvicorn[standard]>=0.54",
    "pydantic>=2.14",
    "pydantic-settings>=2.16",
    "structlog>=26.1",
    "httpx>=0.28",
    "opentelemetry-api>=1.45",
    "opentelemetry-sdk>=1.45",
    "opentelemetry-exporter-otlp-proto-http>=1.45",
    "opentelemetry-instrumentation-fastapi>=0.66b1",
    "opentelemetry-instrumentation-httpx>=0.66b1",
]

[project.scripts]
{{ service_name }} = "{{ package_name }}.__main__:main"

[dependency-groups]
dev = [
    "pytest>=9.1",
    "pytest-asyncio>=1.4",
    "pytest-cov>=7.0",
    # starlette.testclient uses httpx2; runtime code keeps httpx (it has OTel instrumentation).
    "httpx2>=2.16",
    "ruff>=0.17",
    "pyright>=1.1.414",
    "pre-commit>=4.7",
]

[build-system]
requires = ["uv_build>=0.11,<0.12"]
build-backend = "uv_build"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E", "W", "F", "I", "N", "UP", "B", "A", "C4", "SIM", "RET", "PTH",
    "ASYNC", "S", "T20", "PT", "RUF", "TRY", "FBT", "PL", "LOG", "G", "TID",
]
ignore = [
    "PLR2004", # magic values are fine in tests and status codes
    "TRY003",  # long messages in exceptions are fine
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "PLR2004", "FBT"]

[tool.ruff.lint.flake8-tidy-imports.banned-api]
"logging.getLogger".msg = "Use structlog.get_logger() from {{ package_name }}.observability"

[tool.pyright]
include = ["src", "tests"]
pythonVersion = "{{ python_version }}"
typeCheckingMode = "strict"
venvPath = "."
venv = ".venv"
reportMissingTypeStubs = false

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
addopts = "-ra --strict-markers --strict-config"
filterwarnings = ["error"]

[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true
