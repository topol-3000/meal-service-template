"""Alembic environment: `make migrate` applies migrations, `make migration name=...` adds one.

The database URL comes from `DB__URL` through `Settings`, like the service's own. Tests pass
the URL of their container in `config.attributes["database_url"]` instead.
"""

import asyncio

from alembic import context
from sqlalchemy import Connection, pool
from sqlalchemy.ext.asyncio import create_async_engine

from {{ package_name }}.infrastructure.db.models import Base
from {{ package_name }}.observability import configure_logging
from {{ package_name }}.settings import get_settings

config = context.config
# Autogenerate compares the database with these models (see infrastructure/db/models.py).
target_metadata = Base.metadata


def _database_url() -> str:
    url: str | None = config.attributes.get("database_url")
    if url is not None:
        return url
    settings = get_settings()
    # Run from the CLI: Alembic's progress lines go through the service's log pipeline.
    configure_logging(settings)
    return settings.db.url.get_secret_value()


def _run_migrations(connection: Connection) -> None:
    context.configure(connection=connection, target_metadata=target_metadata)
    with context.begin_transaction():
        context.run_migrations()


async def _run_migrations_online() -> None:
    engine = create_async_engine(_database_url(), poolclass=pool.NullPool)
    try:
        async with engine.connect() as connection:
            await connection.run_sync(_run_migrations)
    finally:
        await engine.dispose()


def _run_migrations_offline() -> None:
    """`alembic upgrade head --sql`: print the SQL instead of running it."""
    context.configure(url=_database_url(), target_metadata=target_metadata, literal_binds=True)
    with context.begin_transaction():
        context.run_migrations()


if context.is_offline_mode():
    _run_migrations_offline()
else:
    asyncio.run(_run_migrations_online())
