# Copy to .env for `make run` (uv passes it to the process, so OTEL_* reach the SDK). Inside meal-platform compose these come from compose.yaml.
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
HTTP_PORT={{ http_port }}

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Metrics are pushed every 60 s by default; faster feedback locally.
OTEL_METRIC_EXPORT_INTERVAL=15000
