import json

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient
from opentelemetry.sdk._logs.export import InMemoryLogRecordExporter
from opentelemetry.sdk.metrics.export import HistogramDataPoint, InMemoryMetricReader
from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
from opentelemetry.trace import SpanKind

from {{ package_name }}.main import create_app
from {{ package_name }}.observability import configure_logging, get_logger, get_tracer
from {{ package_name }}.settings import Settings


def _add_ping_route(app: FastAPI) -> FastAPI:
    @app.get("/ping")
    async def ping() -> dict[str, str]:
        get_logger("test").info("ping.handled", answer="pong")
        return {"ping": "pong"}

    return app


@pytest.fixture
def app_with_route(app: FastAPI) -> FastAPI:
    return _add_ping_route(app)


def test_request_creates_server_span(
    app_with_route: FastAPI, span_exporter: InMemorySpanExporter
) -> None:
    with TestClient(app_with_route) as client:
        client.get("/ping")

    server_spans = [s for s in span_exporter.get_finished_spans() if s.kind == SpanKind.SERVER]
    assert [s.name for s in server_spans] == ["GET /ping"]


def test_request_duration_is_recorded_with_stable_attributes(
    app_with_route: FastAPI, metric_reader: InMemoryMetricReader
) -> None:
    with TestClient(app_with_route) as client:
        client.get("/ping")

    data = metric_reader.get_metrics_data()
    [point] = [
        point
        for resource in (data.resource_metrics if data else ())
        for scope in resource.scope_metrics
        for metric in scope.metrics
        if metric.name == "http.server.request.duration"
        for point in metric.data.data_points
        if isinstance(point, HistogramDataPoint)
    ]
    assert point.count == 1
    assert point.attributes is not None
    assert point.attributes["http.route"] == "/ping"
    assert point.attributes["http.response.status_code"] == 200


def test_health_probes_are_not_traced(
    client: TestClient, span_exporter: InMemorySpanExporter
) -> None:
    client.get("/health/live")

    assert span_exporter.get_finished_spans() == ()


def test_log_lines_carry_trace_id(
    settings: Settings,
    span_exporter: InMemorySpanExporter,
    capsys: pytest.CaptureFixture[str],
) -> None:
    # Build the app inside the test: the log handler binds to sys.stdout at creation,
    # and capsys replaces sys.stdout only for the test body.
    app = _add_ping_route(create_app(settings))
    with TestClient(app) as client:
        client.get("/ping")

    lines = [json.loads(line) for line in capsys.readouterr().out.splitlines()]
    ping_log = next(line for line in lines if line["event"] == "ping.handled")
    server_span = next(s for s in span_exporter.get_finished_spans() if s.kind == SpanKind.SERVER)
    assert server_span.context is not None
    assert ping_log["trace_id"] == format(server_span.context.trace_id, "032x")
    assert ping_log["answer"] == "pong"


def test_logs_are_exported_to_otel(
    settings: Settings, log_exporter: InMemoryLogRecordExporter
) -> None:
    configure_logging(settings.model_copy(update={"otel_enabled": True}))

    with get_tracer("test").start_as_current_span("work") as span:
        get_logger("test").warning("something.odd", recipe_id=42)

    [exported] = log_exporter.get_finished_logs()
    record = exported.log_record
    assert record.body == "something.odd"
    assert record.severity_text == "WARN"
    assert record.attributes is not None
    assert record.attributes["recipe_id"] == 42
    assert record.trace_id == span.get_span_context().trace_id
