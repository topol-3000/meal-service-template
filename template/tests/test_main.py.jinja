import httpx2
import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{ package_name }}.api.dependencies import AppState
from {{ package_name }}.infrastructure.http import create_http_client
from {{ package_name }}.main import create_app
from {{ package_name }}.settings import HttpClientSettings, Settings


def test_lifespan_opens_resources_and_closes_them_on_shutdown(app: FastAPI) -> None:
    with TestClient(app):
        state: AppState = app.state.app_state
        http_client = state.http_client
        assert not http_client.is_closed

    assert http_client.is_closed


def test_opened_resources_close_when_startup_fails(
    settings: Settings, monkeypatch: pytest.MonkeyPatch
) -> None:
    opened: list[httpx2.AsyncClient] = []

    def recording_client(client_settings: HttpClientSettings) -> httpx2.AsyncClient:
        opened.append(create_http_client(client_settings))
        return opened[-1]

    def failing_state(**_: object) -> AppState:
        raise RuntimeError("next resource failed to open")

    monkeypatch.setattr("{{ package_name }}.main.create_http_client", recording_client)
    monkeypatch.setattr("{{ package_name }}.main.AppState", failing_state)

    with pytest.raises(RuntimeError, match="next resource"), TestClient(create_app(settings)):
        pass

    [http_client] = opened
    assert http_client.is_closed
