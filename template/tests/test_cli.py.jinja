def test_migrate_command_upgrades_the_configured_database(
    uvicorn_runs: list[str], settings: Settings, monkeypatch: pytest.MonkeyPatch
) -> None:
    upgraded: list[str] = []
    monkeypatch.setattr("{{ package_name }}.__main__.upgrade_to_head", upgraded.append)

    main(["migrate"])

    assert upgraded == [settings.db.url.get_secret_value()]
    assert uvicorn_runs == []


def test_unknown_command_is_rejected(uvicorn_runs: list[str]) -> None:
    with pytest.raises(SystemExit):
        main(["deploy"])

    assert uvicorn_runs == []
