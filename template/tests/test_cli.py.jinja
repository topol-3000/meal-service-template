import pytest
import uvicorn

from {{ package_name }}.__main__ import main
from {{ package_name }}.settings import Settings


@pytest.fixture
def uvicorn_runs(monkeypatch: pytest.MonkeyPatch, settings: Settings) -> list[str]:
    """App paths passed to `uvicorn.run`; settings come from the `settings` fixture."""
    runs: list[str] = []

    def run(app: str, **_: object) -> None:
        runs.append(app)

    monkeypatch.setattr(uvicorn, "run", run)
    monkeypatch.setattr("{{ package_name }}.__main__.get_settings", lambda: settings)
    return runs


