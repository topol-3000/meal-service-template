import inspect
import json
from collections.abc import Iterator

import pytest
from fastapi import FastAPI, HTTPException
from fastapi.testclient import TestClient

from {{ package_name }}.api.errors import PROBLEM_JSON, SERVER_ERROR_DETAIL
from {{ package_name }}.domain import errors
from {{ package_name }}.main import create_app
from {{ package_name }}.settings import Settings


class RecipeNotFoundError(errors.NotFoundError):
    """A feature error: mapped through its base class."""


def _add_raising_routes(app: FastAPI) -> FastAPI:
    """Add `GET /raise/{name}`, which raises the exception named in `_ERRORS`."""

    async def raise_error(name: str) -> None:
        raise _ERRORS[name]

    async def needs_int(value: int) -> int:
        return value

    app.add_api_route("/raise/{name}", raise_error)
    app.add_api_route("/needs-int", needs_int)
    return app


@pytest.fixture
def raising_client(app: FastAPI) -> Iterator[TestClient]:
    # Unhandled errors would otherwise be re-raised into the test.
    with TestClient(_add_raising_routes(app), raise_server_exceptions=False) as client:
        yield client


_ERRORS: dict[str, Exception] = {
    "domain": errors.DomainError("Plan needs at least 3 days"),
    "not-found": errors.NotFoundError("Recipe 42 not found"),
    "feature-not-found": RecipeNotFoundError("Recipe 7 not found"),
    "conflict": errors.ConflictError("Recipe already imported"),
    "validation": errors.ValidationError("Servings must match the plan"),
    "external": errors.ExternalServiceError("LLM at 10.0.0.7:11434 did not answer"),
    "bug": RuntimeError("secret internal detail"),
    "http-dict": HTTPException(409, detail={"recipe_id": 7, "reason": "duplicate"}),
    "http-499": HTTPException(499, detail="Client closed request"),
    "http-599": HTTPException(599),
    "http-304": HTTPException(304),
}


@pytest.mark.parametrize(
    ("name", "status", "title", "detail"),
    [
        ("domain", 400, "Bad Request", "Plan needs at least 3 days"),
        ("not-found", 404, "Not Found", "Recipe 42 not found"),
        ("feature-not-found", 404, "Not Found", "Recipe 7 not found"),
        ("conflict", 409, "Conflict", "Recipe already imported"),
        ("validation", 422, "Unprocessable Content", "Servings must match the plan"),
    ],
)
def test_domain_errors_map_to_problem_details(
    raising_client: TestClient, name: str, status: int, title: str, detail: str
) -> None:
    response = raising_client.get(f"/raise/{name}")

    assert response.status_code == status
    assert response.headers["content-type"] == PROBLEM_JSON
    assert response.json() == {
        "type": "about:blank",
        "title": title,
        "status": status,
        "detail": detail,
        "instance": f"/raise/{name}",
    }


def test_server_side_domain_error_logs_message_but_does_not_send_it(
    settings: Settings, capsys: pytest.CaptureFixture[str]
) -> None:
    # Build the app inside the test: the log handler binds to sys.stdout at creation.
    app = _add_raising_routes(create_app(settings))
    with TestClient(app) as client:
        response = client.get("/raise/external")

    assert response.status_code == 502
    assert response.json() == {
        "type": "about:blank",
        "title": "Bad Gateway",
        "status": 502,
        "detail": SERVER_ERROR_DETAIL,
        "instance": "/raise/external",
    }
    lines = [json.loads(line) for line in capsys.readouterr().out.splitlines()]
    error_log = next(line for line in lines if line["event"] == "http.domain_error")
    assert error_log["error"] == "LLM at 10.0.0.7:11434 did not answer"
    assert error_log["error_type"] == "ExternalServiceError"


def test_unhandled_error_is_500_without_internals(raising_client: TestClient) -> None:
    response = raising_client.get("/raise/bug")

    assert response.status_code == 500
    assert response.headers["content-type"] == PROBLEM_JSON
    assert response.json() == {
        "type": "about:blank",
        "title": "Internal Server Error",
        "status": 500,
        "instance": "/raise/bug",
    }


def test_request_validation_error_lists_fields_without_input(raising_client: TestClient) -> None:
    response = raising_client.get("/needs-int", params={"value": "not-a-number"})

    body = response.json()
    assert response.status_code == 422
    assert response.headers["content-type"] == PROBLEM_JSON
    assert body["detail"] == "Request validation failed"
    [field_error] = body["errors"]
    assert field_error["loc"] == ["query", "value"]
    assert "not-a-number" not in response.text


def test_unknown_route_is_problem_details(raising_client: TestClient) -> None:
    response = raising_client.get("/no-such-route")

    assert response.status_code == 404
    assert response.headers["content-type"] == PROBLEM_JSON
    assert response.json() == {
        "type": "about:blank",
        "title": "Not Found",
        "status": 404,
        "instance": "/no-such-route",
    }


def test_method_not_allowed_keeps_allow_header(raising_client: TestClient) -> None:
    response = raising_client.post("/health/live")

    assert response.status_code == 405
    assert response.headers["allow"] == "GET"
    assert response.json()["title"] == "Method Not Allowed"


def test_http_exception_with_structured_detail_is_problem_details(
    raising_client: TestClient,
) -> None:
    response = raising_client.get("/raise/http-dict")

    assert response.status_code == 409
    assert response.headers["content-type"] == PROBLEM_JSON
    body = response.json()
    assert body["title"] == "Conflict"
    assert json.loads(body["detail"]) == {"recipe_id": 7, "reason": "duplicate"}


@pytest.mark.parametrize(
    ("name", "status", "title", "detail"),
    [
        ("http-499", 499, "Client Error", "Client closed request"),
        ("http-599", 599, "Server Error", None),
    ],
)
def test_http_exception_with_unregistered_status_keeps_it(
    raising_client: TestClient, name: str, status: int, title: str, detail: str | None
) -> None:
    response = raising_client.get(f"/raise/{name}")

    assert response.status_code == status
    assert response.headers["content-type"] == PROBLEM_JSON
    assert response.json()["title"] == title
    assert response.json().get("detail") == detail


def test_http_exception_without_body_status_has_no_body(raising_client: TestClient) -> None:
    response = raising_client.get("/raise/http-304")

    assert response.status_code == 304
    assert response.content == b""


def test_error_handlers_are_async(app: FastAPI) -> None:
    # Starlette would run sync handlers in a worker thread for every error response.
    assert all(inspect.iscoroutinefunction(h) for h in app.exception_handlers.values())
