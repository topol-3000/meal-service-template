def test_ready_reports_an_unreachable_database(client: TestClient) -> None:
    # The `settings` fixture points the database at a port nobody listens on.
    response = client.get("/health/ready")

    assert response.status_code == 503
    assert response.json()["checks"] == {"database": "failed"}
