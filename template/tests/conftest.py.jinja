# Integration tests (`@pytest.mark.integration`) against a real PostgreSQL.


@pytest.fixture(scope="session")
def database_url() -> Iterator[str]:
    """One PostgreSQL container for the test session, migrated to head once."""
    with PostgresContainer(POSTGRES_IMAGE, driver="asyncpg") as postgres:
        url = postgres.get_connection_url()
        upgrade_to_head(url)
        yield url


@pytest.fixture
def alembic_config(database_url: str) -> Config:
    """Alembic pointed at the test database, for running migration commands."""
    return make_alembic_config(database_url)


@pytest.fixture
def db_settings(settings: Settings, database_url: str) -> Settings:
    return settings.model_copy(update={"db": DatabaseSettings(url=SecretStr(database_url))})


@pytest.fixture
async def db_connection(db_settings: Settings) -> AsyncIterator[AsyncConnection]:
    """A connection in a transaction that is rolled back after the test."""
    engine = create_db_engine(db_settings.db)
    try:
        async with engine.connect() as connection:
            transaction = await connection.begin()
            yield connection
            await transaction.rollback()
    finally:
        await engine.dispose()


@pytest.fixture
def db_session_factory(db_connection: AsyncConnection) -> async_sessionmaker[AsyncSession]:
    """Sessions on the test's connection.

    Their commits only release a savepoint, so the test's rollback undoes them too.
    """
    return async_sessionmaker(
        db_connection, expire_on_commit=False, join_transaction_mode="create_savepoint"
    )


@pytest.fixture
async def db_session(
    db_session_factory: async_sessionmaker[AsyncSession],
) -> AsyncIterator[AsyncSession]:
    """For repository tests: everything written through it is rolled back after the test."""
    async with db_session_factory() as session:
        yield session


@pytest.fixture
def db_app(db_settings: Settings) -> FastAPI:
    """The app on the test database. Override this fixture in a module to add routes."""
    return create_app(db_settings)


@pytest.fixture
async def db_client(db_app: FastAPI) -> AsyncIterator[httpx2.AsyncClient]:
    """Client for `db_app`, running its lifespan in the test's own event loop.

    `TestClient` runs the app in a separate loop, and asyncpg connections (like
    `db_connection`) can't be used from another loop.
    """
    transport = httpx2.ASGITransport(app=db_app, raise_app_exceptions=False)
    async with (
        db_app.router.lifespan_context(db_app),
        httpx2.AsyncClient(transport=transport, base_url="http://test") as client,
    ):
        yield client
