@pytest.fixture
async def cache_client(cache_url: str) -> AsyncIterator[Redis]:
    """The test's own client, to look at Valkey directly. Empties the cache after the test."""
    client = create_cache_client(CacheSettings(url=SecretStr(cache_url)))
    try:
        yield client
    finally:
        # redis-py leaves the `**kwargs` of server commands untyped.
        await client.flushdb()  # pyright: ignore[reportUnknownMemberType]
        await client.aclose()


@pytest.fixture
def cache_settings(settings: Settings, cache_url: str, cache_client: Redis) -> Settings:
    """Settings on the test Valkey; through `cache_client`, it is emptied after each test."""
    return settings.model_copy(update={"cache": CacheSettings(url=SecretStr(cache_url))})
