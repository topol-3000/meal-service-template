from {{ package_name }}.infrastructure.http import create_http_client
from {{ package_name }}.settings import HttpClientSettings


async def test_client_uses_configured_timeouts() -> None:
    settings = HttpClientSettings(timeout_seconds=3, connect_timeout_seconds=1)

    async with create_http_client(settings) as client:
        assert client.timeout.read == 3
        assert client.timeout.connect == 1
